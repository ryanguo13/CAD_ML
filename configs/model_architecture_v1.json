  "calibration": {
    "primary": "per_endpoint_logistic_intercept_and_slope",
    "independent_patient_calibration_partition": true,
    "preserve_prevalence": true,
    "phenotype_domain": "PTB_separate_from_angiography_cohort",
    "probabilities_sum_to_one": false
  },
  "resources": {
    "observed_gpu": "NVIDIA GeForce RTX 5060",
    "observed_gpu_memory_mib": 8151,
    "observed_system_memory_bytes": 34184351744,
    "trainable_parameter_budget": 1000000,
    "parameter_count_status": "budget_not_measured",
    "load_one_foundation_model_at_a_time": true,
    "runtime_compatibility_verified": false
  },
  "echo_enabled": false,
  "core_ablations": ["ResNet", "ECGFM_only", "ECGCPC_only", "local_only", "ECGFM_local", "ECGCPC_local", "remove_lead_attention", "remove_summary", "OMI_vs_OMI_AMI", "STMEM_ECGFM_frozen_fusion"],
  "sources": {
    "ecgfm": "https://doi.org/10.1093/jamiaopen/ooaf122",
