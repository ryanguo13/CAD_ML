    "residual_downsampling": {
      "num_stages": 3,
      "kernel": 7,
      "stride_each": 2,
      "channels": 64,
      "output_shape": ["batch", 12, 64, 313]
    },
    "lead_attention": {
      "blocks": 1,
      "dim": 64,
      "heads": 4,
      "ffn_dim": 128,
      "lead_embeddings": 12,
      "attention_axis": "12_leads_at_each_time_index",
      "pre_norm": true,
      "residual": true
    },
    "temporal_convolution": {
      "depthwise_separable": true,
      "kernel": 9,
      "dilations": [1, 2],
      "channels": 64,
      "residual": true
    },
    "pooling": "temporal_mean_and_max_per_lead_then_ordered_flatten",
    "pooled_dim": 1536,
    "amplitude_summary": {
      "per_lead_features": ["p05_mv", "p95_mv", "std_mv", "diff_std_mv"],
      "dim": 48,
      "scaling": "training_partition_fixed_statistics_only",
      "is_validated_st_feature": false
    },
    "projection_input_dim": 1584,
    "output_dim": 128
  },
  "fusion": {
    "type": "concatenate_then_mlp",
    "input_dim": 256,
    "output_dim": 128,
    "activation": "GELU",
    "dropout": 0.2,
    "gating_default": false,
    "metadata_default": false
  },
  "heads": {
    "initial_primary": ["OMI"],
    "next_secondary": ["AMI"],
    "conditional_auxiliary": ["ACS", "CTO"],
    "other_auxiliary_not_default": ["UA", "STEMI", "NSTEMI"],
    "phenotype_input": "local_128d",
    "phenotype_candidates": ["STTC", "MI_pattern", "CD", "HYP", "AFIB", "CLBBB", "CRBBB", "1AVB"],
    "phenotype_labels_require_dictionary_audit": true,
    "cad_head_enabled": false,
    "cad_disabled_reason": "no_complete_verified_CAD_positive_and_negative_reference_labels",
    "output_activation": "independent_sigmoid",
    "strict_hierarchy": false
  },
  "training": {
    "stages": ["freeze_and_cache_base_encoder", "compare_global_only_and_local_only", "PTB_development_local_pretraining", "OMI_fusion", "add_AMI_with_PTB_replay", "separate_calibration", "optional_last_block_or_LoRA"],
    "loss": "masked_BCE_normalized_separately_per_task",
    "initial_weights": {"OMI": 1.0, "AMI": 0.5, "PTB": 0.1},
    "class_reweighting_default": false,
    "microbatch_start": 8,
    "effective_batch_target": 32,
    "head_learning_rate_start": 0.001,
    "optional_encoder_learning_rate_start": 0.000001,
    "development_seeds": [17, 43, 101],
    "do_not_fit_preprocessing_on_test": true,
    "test_split_status": "prior_internal_test_explored_final_evaluation_protocol_must_be_locked",
    "ptb_strict_benchmark": "separate_local_only_checkpoint_exposed_only_to_PTB_development_patients_without_FM_influence",
    "cached_global_features_augmented_jointly": false
