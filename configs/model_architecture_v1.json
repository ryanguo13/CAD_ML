{
  "name": "ecg_coronary_fusion_v1",
  "version": "1.0",
  "date": "2026-10-09",
  "status": "design_specification_only_not_implemented_or_trained",
  "documentation": "docs/模型调研与架构方案.md",
  "input": {
    "shape": ["batch", 12, 5000],
    "sample_rate_hz": 500,
    "duration_seconds": 10,
    "units": "mV",
    "lead_order": ["I", "II", "III", "aVR", "aVL", "aVF", "V1", "V2", "V3", "V4", "V5", "V6"],
    "requires_complete_qualified_12_lead": true
  },
  "global_branch": {
    "encoder": "ECG-FM",
    "checkpoint": null,
    "checkpoint_sha256": null,
    "repo_commit": null,
    "checkpoint_is_prerequisite": true,
    "preprocessing": "lock_exact_native_pipeline_for_selected_public_base_checkpoint",
    "native_sample_rate_hz": 500,
    "native_window_seconds": 5,
    "window_sample_ranges": [[0, 2500], [2500, 5000]],
    "readout": "native_window_embedding_baseline_then_compare_query_pooling",
    "embedding_dim_per_window": 768,
    "window_aggregation": "ordered_concatenation",
    "input_projection_dim": 1536,
    "output_dim": 128,
    "freeze_encoder": true,
    "encoder_eval_mode": true,
    "cache_dtype": "float16",
    "cache_requires": ["record_id", "checkpoint_sha256", "preprocessing_hash", "readout_version"],
    "trainable_query_pooling_requires_tokens": true,
    "alternative_encoder": "ECG-CPC_S4_native_240Hz_with_query_attention_readout",
    "parallel_second_foundation_encoder": false
  },
  "local_branch": {
    "per_record_zscore": false,
    "input_scale_mv": 1.0,
    "learned_denoising": false,
    "shared_across_leads": true,
    "stem": {
      "kernels": [15, 31, 63],
      "channels_each": 16,
      "stride": 2,
      "padding": "same_ceil",
      "activation": "GELU",
      "output_shape": ["batch", 12, 48, 2500]
